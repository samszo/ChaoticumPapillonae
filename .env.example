# Copier en .env puis adapter
# nom de domaine pointant vers le VPS (enregistrement DNS A/AAAA)
DOMAINE=papillons.exemple.org
# 1 en production (HTTPS) ; 0 seulement pour un test en HTTP
CP_COOKIE_SECURE=1
# compte créé ou mis à jour au démarrage (facultatif, sinon : docker compose exec app python3 serveur.py --ajouter-utilisateur NOM)
CP_ADMIN_USER=
CP_ADMIN_PASSWORD=
